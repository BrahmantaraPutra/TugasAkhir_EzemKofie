<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="180dp"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_margin="8dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="180dp"
        app:cardBackgroundColor="@color/EzemGreen"
        android:layout_marginTop="80dp"
        app:cardElevation="4dp"
        app:cardCornerRadius="25dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="15dp"
            android:gravity="bottom">

            <TextView
                android:id="@+id/txt_coffe_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_bold"
                android:maxLines="1"
                android:text="Americano Classic"
                android:textColor="@color/EzemWhite"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/rouned_search"
                android:backgroundTint="@color/EzemLightGray"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@android:drawable/btn_star_big_on"
                    app:tint="@color/EzemWhite" />

                <TextView
                    android:id="@+id/txt_rating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4.1"
                    android:layout_marginStart="4dp"
                    android:textColor="@color/EzemWhite"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/txt_coffe_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$ 3.45"
                android:textColor="@color/EzemWhite"
                android:fontFamily="@font/poppins_bold"
                android:textSize="15sp"
                android:layout_marginTop="10dp"/>
        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <ImageView
        android:id="@+id/img_coffe"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_centerHorizontal="true"
        android:elevation="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/american_classic" />

</RelativeLayout>