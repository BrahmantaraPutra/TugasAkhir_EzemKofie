<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/EzemWhite">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="70dp"
        app:srcCompat="@drawable/logo_green_with_icon"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CREATE ACCOUNT"
        android:fontFamily="@font/poppins_bold"
        android:textSize="25sp"
        android:layout_marginTop="50dp"
        android:textColor="@color/EzemBlack"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Register yourself to become our member aand enjoy all the benefits"
        android:fontFamily="@font/poppins_regular"
        android:textSize="15sp"
        android:layout_marginTop="5dp"
        android:textColor="@color/EzemBlack"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Usename"
        android:fontFamily="@font/poppins_regular"
        android:textSize="15sp"
        android:layout_marginTop="30dp"
        android:textColor="@color/EzemGray"/>
    <EditText
        android:id="@+id/txt_username"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/EzemBlack"
        android:fontFamily="@font/poppins_regular"
        android:textSize="15sp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Full Name"
        android:fontFamily="@font/poppins_regular"
        android:textSize="15sp"
        android:layout_marginTop="10dp"
        android:textColor="@color/EzemGray"/>
    <EditText
        android:id="@+id/txt_fullname"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/EzemBlack"
        android:fontFamily="@font/poppins_regular"
        android:textSize="15sp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Email"
        android:fontFamily="@font/poppins_regular"
        android:textSize="15sp"
        android:layout_marginTop="10dp"
        android:textColor="@color/EzemGray"/>
    <EditText
        android:id="@+id/txt_email"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/EzemBlack"
        android:fontFamily="@font/poppins_regular"
        android:textSize="15sp"/>




    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Password"
        android:fontFamily="@font/poppins_regular"
        android:textSize="15sp"
        android:layout_marginTop="10dp"
        android:textColor="@color/EzemGray"/>
    <EditText
        android:id="@+id/txt_password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/EzemBlack"
        android:fontFamily="@font/poppins_regular"
        android:textSize="15sp"
        android:inputType="textPassword"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Confirm Password"
        android:fontFamily="@font/poppins_regular"
        android:textSize="15sp"
        android:layout_marginTop="10dp"
        android:textColor="@color/EzemGray"/>
    <EditText
        android:id="@+id/txt_confirm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/EzemBlack"
        android:fontFamily="@font/poppins_regular"
        android:textSize="15sp"
        android:inputType="textPassword"/>

    <Button
        android:id="@+id/btn_regis"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="REGISTER"
        android:fontFamily="@font/poppins_bold"
        android:textSize="15sp"
        android:textColor="@color/EzemWhite"
        android:background="@drawable/rounded_bg"
        app:backgroundTint="@color/EzemGreen"
        android:layout_marginTop="50dp"/>



    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_horizontal"
        android:layout_marginTop="5dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Already have an account?"
            android:textColor="@color/EzemBlack"
            android:textSize="13sp"
            android:fontFamily="@font/poppins_regular"/>

        <TextView
            android:id="@+id/txt_linklogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Login here"
            android:textColor="@color/EzemBlack"
            android:textSize="13sp"
            android:fontFamily="@font/poppins_bold"
            android:layout_marginLeft="5dp"/>

    </LinearLayout>

</LinearLayout>